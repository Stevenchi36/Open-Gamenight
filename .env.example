# Copy to .env and fill in the three required lines. docs/self-hosting.md walks through each one.

# ---- Required
# 32+ random characters: openssl rand -base64 32
# (Comments never go after an empty value: Docker Compose would read them as the value.)
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=https://games.example.com    # the address people open, no trailing slash
ALLOWED_ORIGINS=https://games.example.com    # the same address; comma-separate extra ones

# ---- Server
NODE_ENV=production                          # production needs HTTPS to sign in (Secure cookies)
PORT=3000
AUTH_DB_PATH=./data/auth.db                  # ignored in Docker (always /data)
GAMES_DB_PATH=./data/games.db                # ignored in Docker (always /data)

# ---- Real client IPs: count the proxies in front of the app. Too high lets clients fake their IP.
TRUSTED_PROXY_HOPS=0                         # 0 none, 1 one reverse proxy, 2 Cloudflare + a reverse proxy
# CF-Connecting-IP behind Cloudflare, else empty
REAL_IP_HEADER=

# ---- Branding
APP_NAME=Open Gamenight
APP_PRIMARY_COLOR="#6750A4"                   # quoted: an unquoted # starts a comment

# ---- Rooms
ROOM_CREATION=accounts                       # accounts | anyone (anyone suits a private network only)
MAX_ROOMS=50
MAX_ROOMS_PER_USER=2                         # guests' rooms (ROOM_CREATION=anyone) count per IP

# ---- Optional: AI word generation and the admin Assistant (Anthropic API, billed separately)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5
AI_DAILY_OUTPUT_TOKEN_CAP=200000
AI_PER_ADMIN_CALLS_PER_HOUR=20
ANTHROPIC_CHAT_MODEL=claude-opus-5-5         # admin Assistant chat (agentic, needs a current model)
AI_CHAT_MESSAGES_PER_HOUR=60                 # admin Assistant chat, per admin

# ---- Update notice on the admin Overview
UPDATE_CHECK_REPO=Stevenchi36/Open-Gamenight  # a fork sets its own owner/repo; empty turns it off
