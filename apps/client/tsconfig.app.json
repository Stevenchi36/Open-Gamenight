{
  "extends": "@vue/tsconfig/tsconfig.dom.json",
  "include": [
    "env.d.ts",
    "src/**/*",
    "src/**/*.vue",
    "../../games/*/client/**/*",
    "../../games/*/shared/**/*",
    "../../games/client.ts",
    "../../packages/core/src/ui/**/*"
  ],
  "compilerOptions": {
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "noUncheckedIndexedAccess": true,
    "types": [],
    "paths": {
      "@/*": [
        "./src/*"
      ]
    }
  }
}
